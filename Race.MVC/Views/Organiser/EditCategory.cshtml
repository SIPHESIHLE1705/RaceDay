@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit Category";
}
<div class="container mt-4" style="max-width: 640px">
    <div class="page-title"><h1>Edit Category</h1><p>@ViewBag.EventName</p></div>
    <div class="rd-card">
        <div class="rd-card-body">
            <form asp-action="EditCategory" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="CategoryID" />
                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label"></label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryAge" class="form-label"></label>
                        <input asp-for="CategoryAge" type="number" min="0" class="form-control" />
                        <span asp-validation-for="CategoryAge" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryDistance" class="form-label"></label>
                        <input asp-for="CategoryDistance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="CategoryDistance" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input asp-for="StartTime" type="time" class="form-control" value="@Model.StartTime?.ToString(@"hh\:mm")" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save changes</button>
                    <a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
