@model List<EventSummaryDto>
@{
    ViewData["Title"] = "My Events";
}
<div class="container mt-4">
    <div class="page-title d-flex flex-wrap justify-content-between align-items-center">
        <div><h1>My Events</h1><p>Create, edit and manage your events.</p></div>
        <a asp-action="CreateEvent" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create event</a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning">@ViewBag.ErrorMessage</div>
    }

    @if (Model.Count == 0)
    {
        <div class="rd-card empty-state"><i class="bi bi-flag"></i><h4 class="mt-2">No events yet</h4><p>Create your first event to get started.</p></div>
    }
    else
    {
        <div class="rd-card table-responsive">
            <table class="table table-hover mb-0 rd-table">
                <thead>
                    <tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th>Km</th><th>Enrolled</th><th class="text-end">Manage</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@e.EventName</td>
                            <td><i class="bi @EventUi.Icon(e.EventType) text-primary"></i> @e.EventType</td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.EventLocation</td>
                            <td>@e.EventDistance.ToString("0.##")</td>
                            <td><span class="badge text-bg-dark">@e.EnrolmentCount</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Categories" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-primary" title="Categories"><i class="bi bi-tags"></i></a>
                                <a asp-action="Enrolments" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-primary" title="Enrolments"><i class="bi bi-people"></i></a>
                                <a asp-action="Results" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-primary" title="Results"><i class="bi bi-stopwatch"></i></a>
                                <a asp-action="EditEvent" asp-route-id="@e.EventID" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete &quot;@e.EventName&quot;? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
