@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="container py-5 text-center">
    <div class="display-1 text-primary"><i class="bi bi-cone-striped"></i></div>
    <h1 class="mt-3">@Model.Title</h1>
    <p class="lead text-muted">@Model.Message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Back to events</a>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>
